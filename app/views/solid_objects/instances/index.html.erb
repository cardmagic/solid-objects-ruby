<h1>Actors</h1>

<table>
  <thead>
    <tr>
      <th>Type</th>
      <th>ID</th>
      <th>State version</th>
      <th>Generation</th>
      <th>Last used</th>
    </tr>
  </thead>
  <tbody>
    <% @instances.each do |instance| %>
      <tr>
        <td><%= link_to instance.actor_type, instance_path(instance) %></td>
        <td><%= instance.actor_id %></td>
        <td><%= instance.state_version %></td>
        <td><%= instance.activation_generation %></td>
        <td><%= instance.last_used_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>
